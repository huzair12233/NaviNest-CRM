# Copy to .env and fill in.  (.env is gitignored — never commit real secrets)

# ─── Database: PostgreSQL (Neon free tier recommended) ──────────────────────
# From Neon → Connection Details:
#   DATABASE_URL = "Pooled connection"  (host contains "-pooler")
#   DIRECT_URL   = "Direct connection"  (no "-pooler")  — used for schema push / migrations
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/navinest?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/navinest?sslmode=require"

# ─── Auth ───────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-long-random-string"

# ─── First admin account (created by `npm run db:seed`) ─────────────────────
ADMIN_EMAIL="admin@navinest.in"
ADMIN_PASSWORD="use-a-strong-password"
ADMIN_NAME="NaviNest Admin"

# ─── Cloudinary (property photos) ──────────────────────────────────────────
# From Cloudinary dashboard → API Keys. Uploads are signed server-side.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"

# ─── Follow-up reminders: Email (sent via Gmail SMTP — no domain needed) ────
# Turn on 2-Step Verification on the Gmail account, then create an App
# Password at myaccount.google.com/apppasswords and paste it below.
GMAIL_USER="you@gmail.com"
GMAIL_APP_PASSWORD=""

# ─── Follow-up reminders: Telegram (100% free) ─────────────────────────────
# Create a bot via @BotFather on Telegram to get the token + username.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET="generate-a-random-string"

# ─── Cron: authorises calls to /api/cron/reminders ─────────────────────────
CRON_SECRET="generate-a-random-string"

NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

NODE_ENV="development"
