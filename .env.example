# Copy to .env and fill in.  (.env is gitignored — never commit real secrets)

# ─── Database ───────────────────────────────────────────────────────────────
# Local dev (default): SQLite, zero setup.
DATABASE_URL="file:./dev.db"

# Production: PostgreSQL (e.g. Neon free tier).
# Also set provider = "postgresql" and add directUrl in prisma/schema.prisma.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.neon.tech/navinest?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.neon.tech/navinest?sslmode=require"

# ─── Auth ───────────────────────────────────────────────────────────────────
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-long-random-string"

# ─── First admin account (created by `npm run db:seed`) ─────────────────────
ADMIN_EMAIL="admin@navinest.in"
ADMIN_PASSWORD="use-a-strong-password"
ADMIN_NAME="NaviNest Admin"

NODE_ENV="development"
